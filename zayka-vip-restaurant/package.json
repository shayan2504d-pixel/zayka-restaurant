{
  "name": "zayka-vip-restaurant-platform",
  "version": "1.0.0",
  "description": "VIP Luxury Restaurant Platform with Production-Ready Customer Auth & Admin Management",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "migrate:postgres": "node server/migrate-from-sqlite.js",
    "build": "npm --prefix client ci && npm --prefix client run build",
    "vercel-build": "npm run build",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "uuid": "^13.0.0"
  }
}
